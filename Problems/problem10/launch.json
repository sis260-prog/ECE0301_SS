{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C++ Launch (CMake)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreThisFile": false
                }
            ],
            "preLaunchTask": "cmake: build",
            "miDebuggerPath": "gdb"
        }
    ]
}